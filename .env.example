# Copy this file to `.env` and fill in your own values.
# Never commit `.env` or anything inside `secrets/`.

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.8

# --- MongoDB --------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=grad

# --- BunnyCDN -------------------------------------------------------------
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_REGION=de
BUNNY_CDN_BASE_URL=https://your-storage-zone.b-cdn.net

# --- Google Drive ---------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
GOOGLE_DRIVE_FOLDER_ID=

# --- Email verification (Gmail) -------------------------------------------
SMTP_GMAIL_USER=
SMTP_GMAIL_APP_PASSWORD=

# --- Email verification (Outlook) -----------------------------------------
SMTP_OUTLOOK_USER=
SMTP_OUTLOOK_PASSWORD=

# --- Speech synthesis and transcription -----------------------------------
TTS_MODEL=microsoft/speecht5_tts
TTS_DEVICE=cuda
WHISPER_COMMAND=whisper
WHISPER_DEVICE=cuda

# --- Runtime --------------------------------------------------------------
WORKSPACE_DIR=data
CONVERSATION_PICKLE=data/artifacts/conversation.pkl
LOG_LEVEL=INFO
